#!/usr/bin/env python3
"""The PreToolUse hook of a Jarvis turn: the gate (1.7, D36).

Installed root-owned (1.15, phase 1c) and named in the static turn settings,
so it runs next to the user's own hooks for every tool call of a turn the
wrapper started. It reads the hook input (one JSON object) on stdin and
finds its configuration through `JARVIS_AGENT_CONFIG`, which the wrapper put
in the turn's environment together with `JARVIS_TURN_CHECKOUT`.

Three answers:
- no turn marker (`JARVIS_TURN`) in the environment: exit 0 at once,
  before anything is imported or read. The coding session is never gated,
  whether the rest of this script works or not;
- a call no rule gates, and a gated call whose hash equals the grant in
  `JARVIS_GRANT` (once): exit 0 in silence;
- every other gated call: denied, with a reason for the agent. A nameable
  one becomes the turn's pending call (agent_host.decision).

Failing closed: inside a turn, unreadable rules, an unparsable call, a
missing configuration or a crash all deny the call.
"""
import os
import sys

if "JARVIS_TURN" not in os.environ:
    sys.exit(0)

import json  # noqa: E402 - nothing is imported before the turn marker check


def _deny(reason: str) -> None:
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        },
    }))
    sys.stdout.flush()


_FALLBACK_REASON = (
    "[needs_desk] The gate could not decide about this call, so it is refused. That"
    " one needs the desk. Stop here and end your turn."
)


def main() -> int:
    try:
        from pathlib import Path

        sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
        from agent_host import decision
        from agent_host.config import load_config

        reason = decision.REASON_ERROR
        payload = json.loads(sys.stdin.buffer.read().decode("utf-8"))
        config = load_config(Path(os.environ["JARVIS_AGENT_CONFIG"]))
        checkout = os.environ["JARVIS_TURN_CHECKOUT"]
        if not os.path.isabs(checkout):
            raise ValueError("JARVIS_TURN_CHECKOUT is not an absolute path")
        result = decision.decide(
            payload, config, turn_checkout=Path(checkout),
            turn_id=os.environ["JARVIS_TURN_ID"],
            grant=os.environ.get("JARVIS_GRANT") or None,
            grant_base=os.environ.get("JARVIS_GRANT_BASE") or None,
        )
    except BaseException:  # noqa: BLE001 - whatever went wrong, the call is denied
        _deny(locals().get("reason", _FALLBACK_REASON))
        return 0
    if not result.allow:
        _deny(result.reason)
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except BaseException:  # noqa: BLE001 - even the denial failed: block by exit code
        sys.stderr.write(_FALLBACK_REASON)
        code = 2
    sys.exit(code)
