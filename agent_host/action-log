#!/usr/bin/env python3
"""The PostToolUse hook of a Jarvis turn: the action log (1.12b, D38).

Installed root-owned (1.15) and named in the static turn settings. For
every tool call of a turn that can change something (everything except the
read-only file and search tools) it appends one line to
`<state dir>/actions/<turn id>.jsonl`: the tool, the command or target, the
exit status, with values shaped like secrets redacted. The tool's output is
never logged.

Without the turn marker (`JARVIS_TURN`) it exits 0 at once, before anything
is imported or read: the coding session is not logged. It never blocks and
never fails a call: a log that cannot be written is a gap in the account,
not a reason to stop the work (the gate, not this hook, is what refuses).
"""
import os
import sys

if "JARVIS_TURN" not in os.environ:
    sys.exit(0)


def main() -> int:
    try:
        import json
        from datetime import datetime, timezone
        from pathlib import Path

        sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
        from agent_host import record
        from agent_host.config import load_config
        from agent_host.sessions import is_canonical_uuid

        turn_id = os.environ["JARVIS_TURN_ID"]
        if not is_canonical_uuid(turn_id):
            return 0
        payload = json.loads(sys.stdin.buffer.read().decode("utf-8"))
        if not isinstance(payload, dict):
            return 0
        line = record.action_line(payload, datetime.now(timezone.utc).isoformat())
        if line is None:
            return 0
        config = load_config(Path(os.environ["JARVIS_AGENT_CONFIG"]))
        record.append_action(config.actions_dir, turn_id, line)
    except BaseException:  # noqa: BLE001 - this hook never fails a call
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
